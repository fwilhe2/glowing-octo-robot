# Pinned to a Debian snapshot, for the reasons builder/Containerfile sets out at length:
# a dated base image so `debian:sid` cannot drift under an old checkout, and apt pointed
# at snapshot.debian.org so `apt-get install` resolves the same package versions it did on
# the day. Same date in both files; they are bumped together.
#
# It matters here for a reason it does not there. The builder decides what the binaries
# are compiled *by*; this image decides what the shipped bytes *are* — mkfs.ext4 lays out
# the filesystem and strip decides what comes out of every ELF object. An unpinned
# e2fsprogs or binutils means the same tree produces a different image, which is the one
# thing test/size-budget.txt has to be able to compare across runs.
ARG SNAPSHOT=20260824
FROM debian:sid-${SNAPSHOT}@sha256:c1acdb109bacb5adf0f2078892ac177ee2e2ce6f88e96c5b743998b5489d36a9

ARG SNAPSHOT

# binutils is here for strip: build-rootfs.sh drops the debug symbols the packages are
# compiled with, which is about half the size of the shipped tree.
RUN rm -f /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list \
    && printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%sT000000Z sid main\n' "$SNAPSHOT" \
       > /etc/apt/sources.list \
    && apt-get update && apt-get -y install e2fsprogs cpio binutils

COPY image/build-rootfs.sh /usr/local/bin/
RUN chmod +X /usr/local/bin/build-rootfs.sh

# The declared images, and the parser that reads them. tools/variants.sh reads the same
# two directories from the working tree on the host — one parser, two callers on opposite
# sides of this container boundary, because a host that thinks `net` builds for `oci` and
# a container that thinks it does not is a wrong image nobody would go looking for.
COPY image/variant-lib.sh /usr/local/bin/
COPY image/variants /variants
COPY image/platforms /platforms

# The accepted backlog of unresolved libraries. build-rootfs.sh now *fails* an image
# whose binaries need something it does not ship — which a subset can be and the superset
# never is — and it holds every variant to the same allowlist test/check-rootfs-deps.sh
# holds the staging tree to. Two lists would drift.
COPY test/known-missing-libs.txt /known-missing-libs.txt

COPY image/files /files

WORKDIR /usr/local/src