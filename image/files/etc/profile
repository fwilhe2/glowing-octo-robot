# Read by bash for a *login* shell only, before ~/.bash_profile — which on this image
# means the serial getty's login and nothing else. There is no /etc/bashrc: a non-login
# interactive shell reads ~/.bashrc, and the image ships no home directory content.
#
# Without this file a login gets bash's compiled-in fallbacks, which is what the console
# has been showing all along: the prompt `-bash-5.3#` is bash's `\s-\v\$`, set because
# nothing else set PS1.

# util-linux's login derives PATH from ENV_PATH/ENV_SUPATH in /etc/login.defs, and with
# no login.defs it falls back to its compiled-in default. Pin it here so a login shell
# gets the same PATH whatever started it. /bin, /sbin and /usr/sbin are all symlinks
# into /usr/bin on this merged-/usr image, so naming them would only add duplicates.
PATH=/usr/local/bin:/usr/bin
export PATH

PS1='[\u@\h \W]\$ '

umask 022

# The reason this file has to exist at all: systemd installs its shell drop-ins as
# symlinks in /etc/profile.d (and systemd-tmpfiles recreates them at every boot from
# /usr/lib/tmpfiles.d/20-systemd-*.conf), and a drop-in directory does nothing without
# something to source it. Unreadable or failing snippets are skipped rather than taking
# the login down with them.
if [ -d /etc/profile.d ]; then
    for _profile_d in /etc/profile.d/*.sh; do
        [ -r "$_profile_d" ] && . "$_profile_d"
    done
    unset _profile_d
fi

# The loop above is the last thing that runs, and `[ -r ... ] && .` leaves a non-zero
# status behind when the final glob entry is unreadable. Return a clean one so a caller
# that checks does not see a failed login shell.
true
