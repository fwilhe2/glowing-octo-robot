# No account has a password, and `*` is not a hash any password can match. Logins are
# handed in per machine instead, as systemd credentials on the kernel command line:
# ssh.authorized_keys.root for sshd, and login.noauth for the serial console, which
# util-linux's login reads and test/qemu-lib.sh passes. Whoever controls the VMM already
# owns the guest, so the console needs nothing more; nobody else has a password to try.
# image/build-rootfs.sh fails the build if a real hash ever comes back.
root:*:20000:0:99999:7:::
user:*:20000:0:99999:7:::
