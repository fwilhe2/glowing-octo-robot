root:x:0:0:root:/root:/bin/bash
# uid 1000, deliberately: systemd allocates system users from below SYSTEM_UID_MAX,
# which is 999 when there is no /etc/login.defs to say otherwise, so nothing
# systemd-sysusers creates at boot can collide with this one. Home is created by
# image/build-rootfs.sh — nothing in the image would create it on first login.
user:x:1000:1000:user:/home/user:/bin/bash
